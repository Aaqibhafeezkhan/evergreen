{
  "name": "evergreen-deprecation",
  "version": "0.7.1",
  "description": "Find end-of-life and deprecated runtimes, packages, and GitHub Actions at exact file locations, with sources and migration context. CLI, MCP server, GitHub Action, Agent Skill.",
  "keywords": [
    "deprecation",
    "deprecated",
    "end-of-life",
    "eol",
    "lifecycle",
    "dependencies",
    "dependency-check",
    "nodejs",
    "npm",
    "python",
    "github-actions",
    "sarif",
    "migration",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "agent-skills",
    "cli",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arminazimi/evergreen.git"
  },
  "homepage": "https://arminazimi.github.io/evergreen/",
  "bugs": "https://github.com/arminazimi/evergreen/issues",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./sdk": {
      "types": "./dist/src/sdk.d.ts",
      "import": "./dist/src/sdk.js"
    },
    "./conformance": {
      "types": "./dist/src/conformance/index.d.ts",
      "import": "./dist/src/conformance/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp.d.ts",
      "import": "./dist/src/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "evergreen-deprecation": "dist/src/cli.js",
    "evergreen": "dist/src/cli.js",
    "evergreen-mcp": "dist/src/mcp-cli.js",
    "evergreen-lsp": "dist/src/lsp.js"
  },
  "files": [
    "dist/src",
    "examples",
    "data",
    "registry",
    "schemas",
    "skills",
    "!examples/demo",
    "!examples/gallery",
    "!registry/sources.lock.json",
    "!schemas/vendor",
    "!**/*.map",
    "!skills/**/evals"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/usage/queries','dist/src/usage/queries',{recursive:true});fs.cpSync('src/usage/vendor','dist/src/usage/vendor',{recursive:true})\"",
    "build:action": "ncc build src/action.ts -o dist/action --minify --transpile-only",
    "build:plugins": "npm run build --silent && node dist/tools/plugin-packages.js",
    "package:codex-plugin": "npm run build:plugins --silent && node dist/tools/codex-plugin-release.js",
    "dev": "npm run build --silent && node dist/src/cli.js",
    "mcp": "npm run build --silent && node dist/src/mcp-cli.js",
    "test": "npm run build --silent && node tools/run-tests.mjs",
    "test:fuzz": "npm run build --silent && node --test dist/tests/fuzz/parsers.test.js",
    "test:mutation": "stryker run",
    "test:coverage": "npm run build --silent && node --test --experimental-test-coverage --test-coverage-exclude=\"dist/tests/**\" --test-coverage-exclude=\"dist/benchmarks/**\" --test-coverage-exclude=\"dist/action/**\" --test-coverage-exclude=\"dist/src/usage/vendor/**\" --test-coverage-lines=93 --test-coverage-branches=87 --test-coverage-functions=93 --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info \"dist/tests/**/*.test.js\"",
    "test:coverage:lcov": "npm run build --silent && node --test --experimental-test-coverage --test-coverage-exclude=\"dist/tests/**\" --test-coverage-exclude=\"dist/benchmarks/**\" --test-coverage-exclude=\"dist/action/**\" --test-coverage-exclude=\"dist/src/usage/vendor/**\" --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info \"dist/tests/**/*.test.js\"",
    "check": "npm run build && node dist/tools/check-pipeline.js",
    "check:reproducible": "npm run build --silent && node dist/tools/reproducible-build.js",
    "check:action-bundle": "git diff --exit-code -- dist/action/index.js",
    "check:plugins": "npm run build --silent && node dist/tools/plugin-packages.js --check",
    "check:sources": "npm run build --silent && node dist/tools/check-sources.js",
    "benchmark:usage": "npm run build --silent && node dist/benchmarks/source-usage.js",
    "benchmark:perf-budget": "npm run build --silent && node dist/benchmarks/perf-budget.js",
    "benchmark:monorepo": "npm run build --silent && node dist/benchmarks/monorepo.js",
    "benchmark:first-run": "npm run build --silent && node dist/benchmarks/first-run.js",
    "eval:skill-triggers": "npm run build --silent && node dist/benchmarks/skill-trigger-eval.js",
    "eval:plugins": "npm run build --silent && node dist/benchmarks/plugin-host-eval.js",
    "eval:agent-loop": "npm run build --silent && node dist/benchmarks/agent-loop/index.js",
    "validate:codex-plugin": "npm run build --silent && node dist/tools/validate-codex-plugin.js",
    "validate:public-repos": "npm run build --silent && node dist/benchmarks/public-repositories.js",
    "differential:report": "npm run build --silent && node dist/benchmarks/differential/report.js",
    "differential:pluto": "npm run build --silent && node dist/benchmarks/differential/pluto.js",
    "differential:renovate": "npm run build --silent && node dist/benchmarks/differential/renovate.js",
    "differential:xeol": "npm run build --silent && node dist/benchmarks/differential/xeol.js",
    "validate:held-out": "npm run build --silent && node dist/benchmarks/held-out.js",
    "record:corpus-run": "npm run build --silent && node dist/benchmarks/record-corpus-run.js",
    "corpus:warm": "npm run build --silent && node dist/benchmarks/public-repositories.js --warm",
    "corpus:cache": "npm run build --silent && node dist/benchmarks/corpus-cache-cli.js",
    "observe:public-repos": "npm run build --silent && node dist/benchmarks/public-repositories.js --observe",
    "prepack": "npm run check",
    "release:notes": "npm run build --silent && node dist/tools/changelog.js",
    "metrics:adoption": "npm run build --silent && node dist/tools/adoption-metrics.js",
    "report:monthly": "npm run build --silent && node dist/tools/monthly-report.js",
    "org:rollout": "npm run build --silent && node dist/tools/org-rollout.js",
    "build:data-bundle": "npm run build --silent && node dist/tools/build-data-bundle.js",
    "build:data-api": "npm run build --silent && node dist/tools/build-data-api.js",
    "check:data-api": "npm run build --silent && node dist/tools/build-data-api.js --check",
    "build:llms": "npm run build --silent && node dist/tools/build-llms-full.js",
    "build:coverage": "npm run build --silent && node dist/tools/coverage-matrix.js",
    "check:reference": "npm run build --silent && node dist/tools/build-reference-pages.js --check",
    "build:reference": "npm run build --silent && node dist/tools/build-reference-pages.js",
    "check:og-images": "npm run build --silent && node dist/tools/build-og-images.js --check",
    "build:og-images": "npm run build --silent && node dist/tools/build-og-images.js",
    "check:answer-pages": "npm run build --silent && node dist/tools/build-answer-pages.js --check",
    "build:answer-pages": "npm run build --silent && node dist/tools/build-answer-pages.js",
    "check:llms": "npm run build --silent && node dist/tools/build-llms-full.js --check",
    "build:dashboard": "npm run build --silent && node dist/tools/build-dashboard-data.js --today run-date",
    "check:dashboard": "npm run build --silent && node dist/tools/build-dashboard-data.js --today run-date --check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@vercel/ncc": "^0.45.0",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/verify": "^4.1.2",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "mcpName": "io.github.arminazimi/evergreen"
}
