{
  "name": "evergreen",
  "version": "0.0.1",
  "description": "Local-first deprecation intelligence for software repositories.",
  "type": "module",
  "bin": {
    "evergreen": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "registry"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build --silent && node dist/src/cli.js",
