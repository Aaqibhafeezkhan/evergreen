{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/registry.v2.schema.json",
  "title": "Evergreen lifecycle registry v2",
  "description": "Reviewed lifecycle rules keyed by Package URL (PURL) and version range (VERS), with provenance. See docs/decisions/0004-registry-v2.md.",
  "type": "object",
  "required": ["schemaVersion", "ecosystem", "rules"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "evergreen.registry.v2" },
    "ecosystem": { "$ref": "#/$defs/slug" },
    "freshness": {
      "description": "How long a rule may go without review before tooling reports it as stale. Scans never fail on staleness.",
      "type": "object",
      "required": ["maxReviewAgeDays"],
      "additionalProperties": false,
      "properties": {
        "maxReviewAgeDays": { "type": "integer", "minimum": 1 }
      }
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rule": {
      "type": "object",
      "required": ["id", "ecosystem", "purl", "vers", "event", "title", "summary", "severity", "sources", "provenance"],
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "description": "Ecosystem-specific matching hints, for example x-github-actions. Must agree with purl and vers.",
          "type": "object"
        }
      },
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "ecosystem": { "$ref": "#/$defs/slug" },
        "purl": {
          "description": "Package URL identifying the affected component without a version, for example pkg:npm/request.",
          "type": "string",
          "pattern": "^pkg:[a-z][a-z0-9.+-]*/[^@?#\\s]+$"
        },
        "vers": {
          "description": "VERS range of affected versions, for example vers:npm/* or vers:semver/<5.0.0.",
          "type": "string",
          "pattern": "^vers:[a-z][a-z0-9.+-]*/\\S+$"
        },
        "event": { "enum": ["deprecated", "end-of-support", "end-of-life", "removed", "scheduled-end-of-life"] },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "summary": { "$ref": "#/$defs/nonEmpty" },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "replacement": { "$ref": "#/$defs/nonEmpty" },
        "deadline": { "$ref": "#/$defs/date" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "additionalProperties": false,
            "properties": {
              "title": { "$ref": "#/$defs/nonEmpty" },
              "url": { "type": "string", "pattern": "^https://" },
              "accessedAt": { "$ref": "#/$defs/date" }
            }
          }
        },
        "provenance": {
          "type": "object",
          "required": ["observedAt", "reviewedAt", "reviewer"],
          "additionalProperties": false,
          "properties": {
            "observedAt": { "$ref": "#/$defs/date" },
            "reviewedAt": { "$ref": "#/$defs/date" },
            "reviewer": { "$ref": "#/$defs/nonEmpty" },
            "importer": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "migration": { "$ref": "#/$defs/migration" },
        "usage": {
          "type": "array",
          "items": { "$ref": "#/$defs/usage" }
        }
      }
    },
    "migration": {
      "type": "object",
      "required": ["constraints", "steps", "verification"],
      "additionalProperties": false,
      "properties": {
        "constraints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "instructions", "targets"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/nonEmpty" },
              "title": { "$ref": "#/$defs/nonEmpty" },
              "instructions": { "$ref": "#/$defs/nonEmpty" },
              "targets": { "enum": ["declaration", "usages", "all"] }
            }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "purpose"],
            "additionalProperties": false,
            "properties": {
              "command": { "$ref": "#/$defs/nonEmpty" },
              "purpose": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      }
    },
    "usage": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "language", "module"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "import" },
            "language": { "enum": ["javascript", "typescript", "python", "go", "java", "kotlin", "rust", "csharp", "ruby", "php", "swift", "dart"] },
            "module": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "language", "module", "targets"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "call" },
            "language": { "enum": ["javascript", "typescript", "python", "go", "rust", "csharp", "ruby", "php", "swift", "dart"] },
            "module": { "$ref": "#/$defs/nonEmpty" },
            "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } }
          }
        },
        {
          "description": "A deprecated function, method, class, or option inside a module. Used by parser-backed usage analysis.",
          "type": "object",
          "required": ["kind", "language", "symbol", "shape"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "symbol" },
            "language": { "enum": ["javascript", "typescript", "python"] },
            "module": { "description": "Module that exports the symbol. Omit for globals and builtins.", "$ref": "#/$defs/nonEmpty" },
            "symbol": {
              "description": "Dotted path from the module, for example parse, Buffer.alloc, or datetime.utcnow.",
              "type": "string",
              "pattern": "^[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*$"
            },
            "shape": { "enum": ["call", "construct", "reference", "option"] },
            "option": { "description": "For shape option: the deprecated property name in the options object.", "$ref": "#/$defs/nonEmpty" },
            "argument": { "description": "For shape option: zero-based position of the options argument.", "type": "integer", "minimum": 0 },
            "replacement": { "$ref": "#/$defs/nonEmpty" }
          },
          "allOf": [
            {
              "if": { "properties": { "shape": { "const": "option" } }, "required": ["shape"] },
              "then": { "required": ["option"] },
              "else": { "not": { "anyOf": [{ "required": ["option"] }, { "required": ["argument"] }] } }
            },
            {
              "if": { "properties": { "language": { "const": "python" } }, "required": ["language"] },
              "then": { "properties": { "shape": { "enum": ["call", "reference", "option"] } } }
            }
          ]
        },
        {
          "type": "object",
          "required": ["kind", "language", "key"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "config-key" },
            "language": { "enum": ["javascript", "typescript", "python", "go", "json", "yaml", "toml", "ini"] },
            "key": { "$ref": "#/$defs/nonEmpty" },
            "valueIncludes": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    }
  }
}
