{
  "schemaVersion": "evergreen.registry.v2",
  "ecosystem": "serverless",
  "freshness": {
    "maxReviewAgeDays": 90
  },
  "rules": [
    {
      "id": "serverless.aws-lambda.nodejs14.x",
      "ecosystem": "serverless",
      "purl": "pkg:generic/aws-lambda-runtime/nodejs14.x",
      "vers": "vers:semver/*",
      "event": "end-of-life",
      "title": "AWS Lambda Node.js 14 runtime is end-of-life",
      "summary": "The AWS Lambda runtimes table lists nodejs14.x under Deprecated runtimes with deprecation date 2023-12-04. AWS no longer applies security or other updates to that managed runtime.",
      "severity": "high",
      "replacement": "nodejs22.x or nodejs24.x",
      "deadline": "2023-12-04",
      "sources": [
        {
          "title": "AWS Lambda runtimes",
          "url": "https://docs.aws.amazon.com/lambda/latest/dg/lambda-runtimes.html",
          "accessedAt": "2026-10-21"
        }
      ],
      "provenance": {
        "observedAt": "2026-10-21",
        "reviewedAt": "2026-10-21",
        "reviewer": "arminazimi"
      }
    },
