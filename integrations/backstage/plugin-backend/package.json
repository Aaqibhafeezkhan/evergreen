    "@backstage/config": "^1.0.0",
    "@backstage/errors": "^1.0.0",
    "express": "^4.18.0 || ^5.0.0",
    "express-promise-router": "^4.1.0"
  },
  "devDependencies": {
    "@backstage/backend-plugin-api": "^1.0.0",
    "@backstage/cli": "^0.30.0",
    "@backstage/config": "^1.0.0",
    "@backstage/errors": "^1.0.0",
    "@types/express": "^4.17.21",
    "express": "^4.21.0",
    "express-promise-router": "^4.1.1"
