{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/finding.v1.schema.json",
  "title": "Evergreen finding v1",
  "description": "One evidence-backed lifecycle finding, as returned by explain_deprecation and exposed as an evergreen://findings resource. It is the item schema of the findings array in scan.v1.",
  "type": "object",
  "required": [
    "id",
    "ruleId",
    "detector",
    "title",
    "summary",
    "severity",
    "location",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "ruleId": {
      "type": "string"
    },
    "detector": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "location": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "replacement": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "usages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "language",
          "symbol",
          "location",
          "excerpt"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "import",
              "call",
              "config-key",
              "symbol"
            ]
          },
          "language": {
            "enum": [
              "javascript",
              "typescript",
              "python",
              "ruby",
              "json",
              "yaml",
              "toml",
              "ini",
              "php",
              "swift"
            ]
          },
          "symbol": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "usageCount",
        "affectedFiles",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "usageCount": {
          "type": "integer",
          "minimum": 0
        },
        "affectedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "constraints",
        "steps",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "instructions",
              "targets"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "instructions": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "enum": [
                  "declaration",
                  "usages",
                  "all"
                ]
              }
            }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "command",
              "purpose"
            ],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
