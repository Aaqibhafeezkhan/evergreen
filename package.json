{
  "name": "evergreen-deprecation",
  "version": "0.1.0-alpha.0",
  "description": "Local-first deprecation intelligence for software repositories.",
  "keywords": [
    "deprecation",
    "dependencies",
    "github-actions",
    "nodejs",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arminazimi/evergreen.git"
  },
  "homepage": "https://github.com/arminazimi/evergreen#readme",
  "bugs": "https://github.com/arminazimi/evergreen/issues",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./sdk": {
      "types": "./dist/src/sdk.d.ts",
      "import": "./dist/src/sdk.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "evergreen": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "examples",
    "registry",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:action": "ncc build src/action.ts -o dist/action --minify --transpile-only",
    "dev": "npm run build --silent && node dist/src/cli.js",
    "test": "npm run build --silent && node --test dist/tests/**/*.test.js",
    "check": "npm run build && npm run build:action && npm test && npm run check:action-bundle",
    "check:action-bundle": "git diff --exit-code -- dist/action/index.js",
    "benchmark:usage": "npm run build --silent && node dist/benchmarks/source-usage.js",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  }
}
