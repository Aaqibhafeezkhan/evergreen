        "constraints": [
          "Keep the same parser options, lint rules, and supported syntax (decorators, class properties, Flow) in the new parser configuration."
        ],
        "steps": [
          {
            "id": "replace-babel-eslint",
            "instructions": "Replace babel-eslint with @babel/eslint-parser in dependencies and set the ESLint parser to @babel/eslint-parser.",
            "targets": "all",
            "title": "Replace the parser package"
          },
          {
            "id": "check-babel-config",
            "instructions": "@babel/eslint-parser needs a Babel config (or requireConfigFile: false with parserOptions.babelOptions); add one so the same syntax parses.",
