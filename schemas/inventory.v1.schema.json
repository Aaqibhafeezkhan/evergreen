{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/inventory.v1.schema.json",
  "title": "Evergreen inventory v1",
  "description": "The lifecycle of deployed resources read from export files. Each result names the exact place in the export the claim rests on.",
  "type": "object",
  "required": ["schemaVersion", "results", "unrecognized"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "evergreen.inventory.v1" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "check"],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "object",
            "required": ["importer", "file", "pointer", "resource", "purl"],
            "additionalProperties": false,
            "properties": {
              "importer": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "pointer": { "type": "string" },
              "resource": { "type": "string", "minLength": 1 },
              "purl": { "type": "string", "pattern": "^pkg:" },
              "version": { "type": "string", "minLength": 1 }
            }
          },
          "check": { "$ref": "check.v1.schema.json" }
        }
      }
    },
    "unrecognized": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
