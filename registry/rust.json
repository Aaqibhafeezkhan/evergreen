  "rules": [
    {
      "id": "rust.toolchain.end-of-support-1.98-and-older",
      "ecosystem": "rust",
      "purl": "pkg:generic/rust",
      "vers": "vers:semver/<1.99.0",
      "event": "end-of-support",
      "title": "Rust 1.98 and older are no longer supported",
      "summary": "The Rust project only provides support and security updates for the most recent stable release, so a release line is unsupported once the next stable release ships. Rust 1.99 was released on 2026-10-01.",
      "severity": "medium",
      "replacement": "The latest stable Rust release",
      "deadline": "2026-10-01",
      "sources": [
        {
          "title": "Rust security policy",
          "url": "https://www.rust-lang.org/policies/security"
        },
        {
          "title": "Rust release notes (release dates)",
          "url": "https://github.com/rust-lang/rust/blob/master/RELEASES.md"
        }
      ],
      "provenance": {
        "observedAt": "2026-10-17",
        "reviewedAt": "2026-10-17",
        "reviewer": "arminazimi"
      }
    },
    {
      "id": "rust.crate.failure.unmaintained",
      "ecosystem": "rust",
      "purl": "pkg:cargo/failure",
      "vers": "vers:cargo/*",
      "event": "deprecated",
      "title": "failure is no longer maintained",
      "summary": "The failure crate is officially end-of-life: its former maintainer marked it deprecated and announced there will be no further updates or maintenance.",
      "severity": "medium",
      "replacement": "anyhow, eyre, fehler, or snafu",
      "sources": [
        {
          "title": "RustSec advisory RUSTSEC-2020-0036",
          "url": "https://rustsec.org/advisories/RUSTSEC-2020-0036.html"
        }
      ],
      "provenance": {
        "observedAt": "2026-10-17",
        "reviewedAt": "2026-10-17",
        "reviewer": "arminazimi"
      }
    },
    {
