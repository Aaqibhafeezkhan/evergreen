{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/api-product.v1.schema.json",
  "title": "Evergreen static lifecycle API v1",
  "description": "The documents served under api/v1/: an index of products, one document per product, and the most recently reviewed rules. Every document is generated from registry/*.json and rebuilt to identical bytes.",
  "oneOf": [
    { "$ref": "#/$defs/index" },
    { "$ref": "#/$defs/product" },
    { "$ref": "#/$defs/recent" }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "purl": { "type": "string", "pattern": "^pkg:[a-z][a-z0-9.+-]*/[^@?#\\s]+$" },
    "purlType": { "type": "string", "pattern": "^[a-z][a-z0-9.+-]*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "productPath": { "type": "string", "pattern": "^products/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$" },
    "event": {
      "enum": ["deprecated", "end-of-support", "end-of-life", "removed", "scheduled-end-of-life"]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/event" }
    },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "ecosystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "rule": { "$ref": "registry.v2.schema.json#/$defs/rule" },
    "index": {
      "type": "object",
      "required": ["schemaVersion", "products", "recent", "rules", "latestReview"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "evergreen.api-index.v1" },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/indexEntry" }
        },
        "recent": { "const": "recent.json" },
        "rules": { "type": "integer", "minimum": 1 },
        "latestReview": { "$ref": "#/$defs/date" }
      }
    },
    "indexEntry": {
      "type": "object",
      "required": ["id", "purl", "type", "name", "ecosystems", "events", "latestReview", "rules", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "purl": { "$ref": "#/$defs/purl" },
        "type": { "$ref": "#/$defs/purlType" },
        "namespace": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "ecosystems": { "$ref": "#/$defs/ecosystems" },
        "events": { "$ref": "#/$defs/events" },
        "earliestDeadline": { "$ref": "#/$defs/date" },
        "latestReview": { "$ref": "#/$defs/date" },
        "rules": { "type": "integer", "minimum": 1 },
        "path": { "$ref": "#/$defs/productPath" }
      }
    },
    "product": {
      "type": "object",
      "required": ["schemaVersion", "id", "purl", "type", "name", "ecosystems", "events", "latestReview", "rules"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "evergreen.api-product.v1" },
        "id": { "$ref": "#/$defs/slug" },
        "purl": { "$ref": "#/$defs/purl" },
        "type": { "$ref": "#/$defs/purlType" },
        "namespace": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "ecosystems": { "$ref": "#/$defs/ecosystems" },
        "events": { "$ref": "#/$defs/events" },
        "earliestDeadline": { "$ref": "#/$defs/date" },
        "latestReview": { "$ref": "#/$defs/date" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "recent": {
      "type": "object",
      "required": ["schemaVersion", "changes"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "evergreen.api-recent.v1" },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/$defs/change" }
        }
      }
    },
    "change": {
      "type": "object",
      "required": ["ruleId", "productId", "path", "purl", "ecosystem", "event", "severity", "title", "reviewedAt", "observedAt"],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "productId": { "$ref": "#/$defs/slug" },
        "path": { "$ref": "#/$defs/productPath" },
        "purl": { "$ref": "#/$defs/purl" },
        "ecosystem": { "$ref": "#/$defs/slug" },
        "event": { "$ref": "#/$defs/event" },
        "severity": { "$ref": "#/$defs/severity" },
        "title": { "$ref": "#/$defs/text" },
        "deadline": { "$ref": "#/$defs/date" },
        "reviewedAt": { "$ref": "#/$defs/date" },
        "observedAt": { "$ref": "#/$defs/date" }
      }
    }
  }
}
