  ],
  "id": "pypi-api-shield",
  "latestReview": "2026-10-16",
  "name": "api-shield",
  "purl": "pkg:pypi/api-shield",
  "rules": [
    {
      "ecosystem": "python",
      "event": "deprecated",
      "id": "python.package.api-shield.deprecated",
      "migration": {
        "constraints": [
          "Preserve feature flags, rollout state, rate limits, maintenance windows, storage, and framework adapters."
        ],
        "steps": [
          {
            "id": "replace-api-shield",
            "instructions": "Replace the distribution, change shield imports and commands to waygate, and migrate configuration using the maintained documentation.",
            "targets": "all",
            "title": "Replace api-shield"
          }
        ],
        "verification": [
          {
            "command": "python -m pytest",
            "purpose": "Run policy, rollout, rate-limit, and repository tests."
          }
        ]
      },
      "provenance": {
        "observedAt": "2026-10-16",
        "reviewedAt": "2026-10-16",
        "reviewer": "arminazimi"
      },
      "purl": "pkg:pypi/api-shield",
      "replacement": "waygate",
      "severity": "medium",
      "sources": [
        {
          "title": "api-shield deprecation notice",
          "url": "https://pypi.org/project/api-shield/"
        }
      ],
      "summary": "The maintainer renamed api-shield to waygate and states that no further releases will be published under the old name.",
      "title": "api-shield is deprecated",
      "usage": [
        {
          "kind": "import",
          "language": "python",
          "module": "shield"
        }
      ],
      "vers": "vers:pypi/*",
      "x-python": {
        "kind": "package",
        "package": "api-shield"
      }
    }
  ],
  "schemaVersion": "evergreen.api-product.v1",
  "type": "pypi"
