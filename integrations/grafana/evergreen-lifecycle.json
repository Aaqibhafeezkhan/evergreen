{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Lifecycle risk",
      "type": "row"
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "description": "Every finding in the portal export, counted by severity across all services. The export is one point-in-time snapshot produced by `evergreen export --format portal`.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Info" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Low" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Medium" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "High" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Critical" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "columns": [
            { "selector": "path", "text": "Service", "type": "string" },
            { "selector": "nextEndOfLife", "text": "Next end of life", "type": "string" },
            { "selector": "severities.info", "text": "Info", "type": "number" },
            { "selector": "severities.low", "text": "Low", "type": "number" },
            { "selector": "severities.medium", "text": "Medium", "type": "number" },
            { "selector": "severities.high", "text": "High", "type": "number" },
            { "selector": "severities.critical", "text": "Critical", "type": "number" },
            { "selector": "reportLink", "text": "Report", "type": "string" }
          ],
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
          "format": "table",
          "parser": "simple",
          "refId": "A",
          "root_selector": "services",
          "source": "url",
          "type": "json",
          "url": "${portalExportUrl}",
          "url_options": { "method": "GET" }
        }
      ],
      "title": "Findings by severity",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": { "names": ["Info", "Low", "Medium", "High", "Critical"] }
          }
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "description": "Each service's findings, plotted at the next end-of-life date reported for that service. The export carries no run timestamp, so the x-axis is the deadline timeline, not scan history: keep one export per run (see README) to compare runs side by side.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "unit": "short",
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Info" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Low" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Medium" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "High" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Critical" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 11, "w": 14, "x": 0, "y": 6 },
      "id": 3,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "columns": [
            { "selector": "nextEndOfLife", "text": "Next end of life", "type": "timestamp", "timestampFormat": "YYYY-MM-DD" },
            { "selector": "severities.info", "text": "Info", "type": "number" },
            { "selector": "severities.low", "text": "Low", "type": "number" },
            { "selector": "severities.medium", "text": "Medium", "type": "number" },
            { "selector": "severities.high", "text": "High", "type": "number" },
            { "selector": "severities.critical", "text": "Critical", "type": "number" }
          ],
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
          "format": "table",
          "parser": "simple",
          "refId": "A",
          "root_selector": "services",
          "source": "url",
          "type": "json",
          "url": "${portalExportUrl}",
          "url_options": { "method": "GET" }
        }
      ],
      "title": "Findings by severity over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "description": "The next deadline per service, soonest first, with a link to the detailed Evergreen report for that service. Services whose findings carry no date are omitted.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Next end of life" },
            "properties": [
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Report" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open report", "url": "${__value.text}" }] }
            ]
          }
        ]
      },
      "gridPos": { "h": 11, "w": 10, "x": 14, "y": 6 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "enablePagination": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Next end of life" }]
      },
      "targets": [
        {
          "columns": [
            { "selector": "path", "text": "Service", "type": "string" },
            { "selector": "nextEndOfLife", "text": "Next end of life", "type": "string" },
            { "selector": "reportLink", "text": "Report", "type": "string" }
          ],
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
          "format": "table",
          "parser": "simple",
          "refId": "A",
          "root_selector": "services",
          "source": "url",
          "type": "json",
          "url": "${portalExportUrl}",
          "url_options": { "method": "GET" }
        }
      ],
      "title": "Next end-of-life dates",
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              { "config": { "id": "regex", "options": { "value": "^\\d{4}-\\d{2}-\\d{2}$" } }, "fieldName": "Next end of life" }
            ],
            "match": "all",
            "type": "include"
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
      "description": "Counts per service, worst first. Click a header to sort; the Report column opens the detailed Evergreen report.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Service" },
            "properties": [
              { "id": "custom.width", "value": 320 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Next end of life" },
            "properties": [
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Info" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "text", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Low" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "blue", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Medium" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "yellow", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "High" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Critical" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Report" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open report", "url": "${__value.text}" }] }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 17 },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "enablePagination": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Critical" }]
      },
      "targets": [
        {
          "columns": [
            { "selector": "path", "text": "Service", "type": "string" },
            { "selector": "nextEndOfLife", "text": "Next end of life", "type": "string" },
            { "selector": "severities.info", "text": "Info", "type": "number" },
            { "selector": "severities.low", "text": "Low", "type": "number" },
            { "selector": "severities.medium", "text": "Medium", "type": "number" },
            { "selector": "severities.high", "text": "High", "type": "number" },
            { "selector": "severities.critical", "text": "Critical", "type": "number" },
            { "selector": "reportLink", "text": "Report", "type": "string" }
          ],
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${infinity}" },
          "format": "table",
          "parser": "simple",
          "refId": "A",
          "root_selector": "services",
          "source": "url",
          "type": "json",
          "url": "${portalExportUrl}",
          "url_options": { "method": "GET" }
        }
      ],
      "title": "Services by severity",
      "type": "table"
    }
  ],
  "refresh": "1h",
  "schemaVersion": 39,
  "tags": ["evergreen", "lifecycle", "deprecations", "portal"],
