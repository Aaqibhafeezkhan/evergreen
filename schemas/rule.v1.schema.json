{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/rule.v1.schema.json",
  "title": "Evergreen lifecycle rule v1",
  "description": "One lifecycle rule as exposed to agents through the evergreen://rules/{id} MCP resource.",
  "type": "object",
  "required": ["schemaVersion", "id", "ecosystem", "purl", "affectedVersions", "event", "severity", "title", "summary", "sources", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "evergreen.rule.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "ecosystem": { "type": "string", "minLength": 1 },
    "purl": { "type": "string", "pattern": "^pkg:" },
    "affectedVersions": { "type": "string", "pattern": "^vers:" },
    "event": { "enum": ["deprecated", "end-of-support", "end-of-life", "removed"] },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "replacement": { "type": "string" },
    "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "accessedAt": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["observedAt", "reviewedAt", "reviewer"],
      "additionalProperties": false,
      "properties": {
        "observedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewer": { "type": "string", "minLength": 1 }
      }
    },
    "migration": { "type": "object" }
  }
}
