{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/check.v1.schema.json",
  "title": "Evergreen dependency check v1",
  "description": "The result of checking one package, and optionally one version, against Evergreen's lifecycle rules.",
  "type": "object",
  "required": ["schemaVersion", "purl", "status", "findings", "message"],
  "additionalProperties": false,
  "properties": {
    "data": { "$ref": "scan.v1.schema.json#/properties/data" },
    "schemaVersion": { "const": "evergreen.check.v1" },
    "purl": { "type": "string", "pattern": "^pkg:", "description": "Version-less canonical Package URL." },
    "version": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["affected", "version-dependent", "not-affected", "no-data"],
      "description": "no-data means Evergreen has no rule for the package; it does not mean the package is safe."
    },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"], "description": "Highest severity among the findings." },
    "message": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "ecosystem", "event", "severity", "title", "summary", "affectedVersions", "sources"],
        "additionalProperties": false,
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "ecosystem": { "type": "string", "minLength": 1 },
          "event": { "enum": ["deprecated", "end-of-support", "end-of-life", "removed", "scheduled-end-of-life"] },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string" },
          "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "affectedVersions": { "type": "string", "pattern": "^vers:" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "url"],
              "properties": { "title": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" }, "accessedAt": { "type": "string" } }
            }
          },
          "migration": { "type": "object" }
        }
      }
    }
  }
}
