    { "id": "migration.verify", "status": "supported", "version": "1", "description": "Re-scan and verify that an observed finding is absent.", "ecosystems": ["android", "ci-images", "container", "cpp", "dotnet", "github-actions", "go", "java", "kubernetes", "nodejs", "npm", "php", "python", "ruby", "rust", "serverless", "swift"] },
