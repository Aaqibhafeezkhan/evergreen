{
  "name": "plan-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "plan-monorepo",
      "workspaces": [
        "packages/*",
        "services/*"
      ]
    },
    "packages/api": {
      "name": "@acme/api",
      "version": "1.0.0",
      "dependencies": {
        "request": "^2.88.2",
        "left-pad": "^1.3.0"
      }
    },
    "packages/web": {
      "name": "@acme/web",
      "version": "1.0.0",
      "dependencies": {
        "q": "^1.5.1",
        "querystring": "^0.2.1"
      }
    },
    "packages/worker": {
      "name": "@acme/worker",
      "version": "1.0.0",
      "dependencies": {
        "tslint": "6.1.3",
        "abab": "^2.0.6"
      }
    },
    "services/billing": {
      "name": "@acme/billing",
      "version": "1.0.0",
      "dependencies": {
        "uglify-es": "^3.3.9"
      }
    },
    "node_modules/request": {
      "version": "2.88.2"
    },
    "node_modules/left-pad": {
      "version": "1.3.0"
    },
    "node_modules/q": {
      "version": "1.5.1"
    },
    "node_modules/querystring": {
      "version": "0.2.1"
    },
    "node_modules/tslint": {
      "version": "6.1.3"
    },
    "node_modules/abab": {
      "version": "2.0.6"
    }
  }
}
