            "title": "Upgrade setup-dotnet"
          },
          {
            "id": "review-action-inputs",
            "instructions": "Compare configured inputs with the target release and update renamed or changed options; confirm the runner meets the release's minimum version.",
            "targets": "declaration",
            "title": "Review setup-dotnet inputs"
          }
        ],
        "verification": [
          {
            "command": "git diff --check",
            "purpose": "Validate the edited workflow diff."
          }
        ]
      },
      "provenance": {
        "observedAt": "2026-10-16",
