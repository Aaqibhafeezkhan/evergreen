{
  "productId": "pypi-pyinj",
  "productPath": "products/pypi-pyinj.json",
  "rule": {
    "ecosystem": "python",
    "event": "end-of-life",
    "id": "python.package.pyinj.archived",
    "migration": {
      "constraints": [
        "Preserve provider scopes, binding resolution, constructor injection, overrides, and application startup behavior."
      ],
      "steps": [
        {
          "id": "replace-pyinj",
          "instructions": "Replace the distribution and imports, then translate bindings and injection declarations to the injx API.",
          "targets": "all",
          "title": "Replace pyinj with injx"
        },
        {
          "id": "verify-injection-graph",
          "instructions": "Exercise application startup, nested dependencies, scopes, overrides, and missing-binding errors.",
          "targets": "usages",
          "title": "Verify the injection graph"
        }
      ],
      "verification": [
        {
          "command": "python -m pytest",
          "purpose": "Run dependency-injection and repository tests."
        }
      ]
    },
    "provenance": {
      "observedAt": "2026-10-16",
      "reviewedAt": "2026-10-16",
      "reviewer": "arminazimi"
    },
    "purl": "pkg:pypi/pyinj",
    "replacement": "injx",
    "severity": "medium",
    "sources": [
      {
        "title": "pyinj archival and migration notice",
        "url": "https://pypi.org/project/pyinj/"
      },
      {
        "title": "pyinj project status (PyPI Simple API)",
        "url": "https://pypi.org/simple/pyinj/"
      },
      {
        "title": "Project status markers (PEP 792)",
        "url": "https://packaging.python.org/specifications/project-status-markers/"
      }
    ],
    "summary": "PyPI marks pyinj as archived, and the maintainers state that the repository is no longer maintained.",
    "title": "pyinj is archived on PyPI",
    "usage": [
      {
        "kind": "import",
        "language": "python",
        "module": "pyinj"
      }
    ],
    "vers": "vers:pypi/*",
    "x-python": {
      "kind": "package",
      "package": "pyinj"
    }
  },
  "schemaVersion": "evergreen.api-rule.v1"
}
