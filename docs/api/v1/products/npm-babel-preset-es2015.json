          },
          {
            "id": "configure-targets",
            "instructions": "Set explicit target environments so the replacement emits only the transforms and polyfill behavior the project requires.",
            "targets": "usages",
            "title": "Configure supported targets"
          }
        ],
        "verification": [
          {
            "command": "npm run build --if-present",
            "purpose": "Build the project and verify the replacement Babel output."
          }
        ]
