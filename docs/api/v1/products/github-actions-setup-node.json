{
  "earliestDeadline": "2026-09-23",
  "ecosystems": [
    "github-actions"
  ],
  "events": [
    "end-of-support"
  ],
  "id": "github-actions-setup-node",
  "latestReview": "2026-10-14",
  "name": "setup-node",
  "namespace": "actions",
  "purl": "pkg:github/actions/setup-node",
  "rules": [
    {
      "deadline": "2026-09-23",
      "ecosystem": "github-actions",
      "event": "end-of-support",
      "id": "github-actions.setup-node.node20",
      "migration": {
        "constraints": [
          "Preserve the selected Node.js version, registry authentication, and dependency-cache behavior."
        ],
        "steps": [
          {
            "id": "upgrade-action-ref",
            "instructions": "Change the uses reference to actions/setup-node@v5 or a later supported major.",
            "targets": "declaration",
            "title": "Upgrade setup-node"
          },
          {
            "id": "review-action-inputs",
            "instructions": "Confirm node-version, registry-url, cache, and cache-dependency-path remain valid for the target release.",
            "targets": "declaration",
            "title": "Review runtime and cache inputs"
          }
        ],
        "verification": [
          {
            "command": "git diff --check",
            "purpose": "Validate the edited workflow diff."
          }
        ]
      },
      "provenance": {
        "observedAt": "2026-10-13",
        "reviewedAt": "2026-10-14",
        "reviewer": "arminazimi"
      },
      "purl": "pkg:github/actions/setup-node",
      "replacement": "actions/setup-node@v5 or later",
      "severity": "high",
      "sources": [
        {
          "title": "Node 20 is no longer available in GitHub Actions",
          "url": "https://github.blog/changelog/2026-09-23-node-20-is-no-longer-available-in-github-actions/"
        },
        {
          "title": "actions/setup-node v5 runtime guidance",
          "url": "https://github.com/actions/setup-node#breaking-changes-in-v5"
        }
      ],
      "summary": "This release predates the action's Node.js 24 runtime. GitHub no longer provides Node.js 20 on Actions runners.",
      "title": "Unsupported actions/setup-node runtime",
      "vers": "vers:semver/<5.0.0",
      "x-github-actions": {
        "action": "actions/setup-node",
        "supportedFromMajor": 5
      }
    }
  ],
  "schemaVersion": "evergreen.api-product.v1",
  "type": "github"
}
