{
  "earliestDeadline": "2026-09-23",
  "ecosystems": [
    "github-actions"
  ],
  "events": [
    "end-of-support"
  ],
  "id": "github-actions-cache",
  "latestReview": "2026-10-14",
  "name": "cache",
  "namespace": "actions",
  "purl": "pkg:github/actions/cache",
  "rules": [
    {
      "deadline": "2026-09-23",
      "ecosystem": "github-actions",
      "event": "end-of-support",
      "id": "github-actions.cache.node20",
      "migration": {
        "constraints": [
          "Preserve cache keys, restore-key ordering, paths, and cache-hit dependent control flow."
        ],
        "steps": [
          {
            "id": "upgrade-action-ref",
            "instructions": "Change the uses reference to actions/cache@v5 or a later supported major.",
            "targets": "declaration",
            "title": "Upgrade the cache action"
          },
          {
            "id": "review-cache-contract",
            "instructions": "Verify cache paths, keys, restore keys, and cache-hit output consumers against the target release.",
            "targets": "declaration",
            "title": "Review cache behavior"
          }
        ],
        "verification": [
          {
            "command": "git diff --check",
            "purpose": "Validate the edited workflow diff."
          }
        ]
      },
      "provenance": {
        "observedAt": "2026-10-13",
        "reviewedAt": "2026-10-14",
        "reviewer": "arminazimi"
      },
      "purl": "pkg:github/actions/cache",
      "replacement": "actions/cache@v5 or later",
      "severity": "high",
      "sources": [
        {
          "title": "Node 20 is no longer available in GitHub Actions",
          "url": "https://github.blog/changelog/2026-09-23-node-20-is-no-longer-available-in-github-actions/"
        },
        {
          "title": "actions/cache runtime and service guidance",
          "url": "https://github.com/actions/cache#whats-new"
        }
      ],
      "summary": "This release uses a retired JavaScript runtime or cache service. Version 5 moved the action to Node.js 24.",
      "title": "Unsupported actions/cache runtime",
      "vers": "vers:semver/<5.0.0",
      "x-github-actions": {
        "action": "actions/cache",
        "supportedFromMajor": 5
      }
    }
  ],
  "schemaVersion": "evergreen.api-product.v1",
  "type": "github"
}
