# Records the year-in-review section of docs/SHOWCASE.md.
# Generate with: vhs docs/demos/wrapped.tape
Output docs/demos/wrapped.gif

Set Shell "bash"
Set FontSize 14
Set Width 900
Set Height 400
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set Prompt "❯ "

Type "evergreen wrapped . --year 2025 --no-animation"
Enter
Sleep 4s
