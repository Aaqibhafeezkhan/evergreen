{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/forecast.v1.schema.json",
  "title": "Evergreen forecast v1",
  "type": "object",
  "required": ["schemaVersion", "root", "today", "until", "months", "groups", "affecting", "total"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "evergreen.forecast.v1" },
    "root": { "type": "string" },
    "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "until": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "months": { "type": "integer", "minimum": 1, "maximum": 36 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["month", "events"],
        "additionalProperties": false,
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "events": {
            "type": "array",
            "items": { "$ref": "#/$defs/event" }
          }
        }
      }
    },
    "affecting": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["date", "ruleId", "ecosystem", "title", "severity", "source", "findings"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "ruleId": { "type": "string", "minLength": 1 },
        "ecosystem": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "source": { "type": "string" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
