{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/context.v1.schema.json",
  "title": "Evergreen migration context v1",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "repositoryRoot", "finding", "affectedFiles", "usages", "constraints", "steps", "sources", "verification"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "evergreen.context.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repositoryRoot": { "type": "string" },
    "finding": { "$ref": "scan.v1.schema.json#/properties/findings/items" },
    "affectedFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "usages": {
      "type": "array",
      "items": { "$ref": "scan.v1.schema.json#/properties/findings/items/properties/usages/items" }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "instructions", "targets", "paths"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "instructions": { "type": "string" },
          "targets": { "enum": ["declaration", "usages", "all"] },
          "paths": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "scan.v1.schema.json#/properties/findings/items/properties/sources/items" }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "purpose"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    }
  }
}
