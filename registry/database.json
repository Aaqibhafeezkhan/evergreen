  "rules": [
    {
      "id": "database.postgresql.end-of-life-11",
      "ecosystem": "database",
      "purl": "pkg:generic/postgresql",
      "vers": "vers:semver/>=11.0.0|<12.0.0",
      "event": "end-of-life",
      "title": "PostgreSQL 11 is no longer a supported major version",
      "summary": "The PostgreSQL Global Development Group lists 11 as unsupported: its final release was on November 9, 2023, so it receives no further bug or security fixes. A database image tag or managed engine_version on this line runs unsupported software.",
      "severity": "high",
      "replacement": "PostgreSQL 16 or later",
      "deadline": "2023-11-09",
      "sources": [
        {
          "title": "PostgreSQL versioning policy",
          "url": "https://www.postgresql.org/support/versioning/"
        },
        {
          "title": "endoflife.date: PostgreSQL",
          "url": "https://endoflife.date/postgresql"
        }
      ],
      "provenance": {
        "observedAt": "2026-10-22",
        "reviewedAt": "2026-10-22",
        "reviewer": "arminazimi"
      }
    },
