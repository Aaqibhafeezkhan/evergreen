      "severity": "medium",
      "replacement": "std::io::IsTerminal (stable since Rust 1.70), or the is-terminal crate for older compilers",
      "sources": [
        {
          "title": "RustSec advisory RUSTSEC-2024-0375",
          "url": "https://rustsec.org/advisories/RUSTSEC-2024-0375.html"
