      "commit": "769652353aacf84fb8ab691e4ec2c6435ad2ee3a",
      "finding": {
        "ruleId": "rust.crate.atty.unmaintained",
        "path": "Cargo.toml",
        "line": 23
      },
      "expectedEndState": {
        "description": "Cargo.toml no longer depends on atty; terminal detection uses std::io::IsTerminal or an equivalent maintained API.",
        "checks": [
          { "path": "Cargo.toml", "mustNotMatch": "^atty\\s*=" }
        ]
      },
      "verification": ["cargo build --all-targets && cargo test"],
      "migrationEvidence": {
        "commit": "https://github.com/sharkdp/hyperfine/commit/69ee1738d48e978a936cab07a984812ee364f8e8",
        "summary": "Removed atty and switched to std::io::IsTerminal."
