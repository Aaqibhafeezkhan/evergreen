{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/verification.v1.schema.json",
  "title": "Evergreen migration verification v1",
  "type": "object",
  "required": ["schemaVersion", "repositoryRoot", "findingId", "verifiedAt", "verified", "commandsExecuted", "summary", "remainingFindings", "suggestedCommands"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "evergreen.verification.v1" },
    "repositoryRoot": { "type": "string" },
    "findingId": { "type": "string", "minLength": 1 },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "verified": { "type": "boolean" },
    "commandsExecuted": { "const": false },
    "summary": { "type": "string", "minLength": 1 },
    "remainingFindings": {
      "type": "array",
      "items": { "$ref": "scan.v1.schema.json#/properties/findings/items" }
    },
    "suggestedCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "purpose"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "receipt": {
      "description": "What the change since the session's last scan did to the repository's findings. Present when a scan was observed before verification.",
      "$ref": "receipt.v1.schema.json"
    },
    "receipt_markdown": {
      "type": "string",
      "minLength": 1,
      "description": "The receipt rendered for a pull request body, with the evergreen-receipt marker."
    }
  }
}
