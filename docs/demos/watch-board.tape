# Records the watch-board section of docs/SHOWCASE.md.
# Generate with: vhs docs/demos/watch-board.tape
Output docs/demos/watch-board.gif

Set Shell "bash"
Set FontSize 14
Set Width 900
Set Height 320
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set Prompt "❯ "

Type "evergreen watch --board"
Enter
Sleep 4s
