lockfileVersion: '9.0'

settings:
  autoInstallPeers: true
  excludeLinksFromLockfile: false

importers:

  .:
    dependencies:
      ready-prod:
        specifier: ^1.0.0
        version: 1.0.0
      blocked-prod:
        specifier: ^2.0.0
        version: 2.0.0
      invalid-range:
        specifier: ^1.0.0
        version: 1.0.0
    devDependencies:
      dev-only:
        specifier: ^1.0.0
        version: 1.0.0

packages:

  ready-prod@1.0.0:
    resolution: {integrity: sha512-ready}
    engines: {node: '>=20'}

  blocked-prod@2.0.0:
    resolution: {integrity: sha512-blocked}
    engines:
      node: '>=24'

  dev-only@1.0.0:
    resolution: {integrity: sha512-dev}
    engines: {node: '>=24'}

  invalid-range@1.0.0:
    resolution: {integrity: sha512-invalid}
    engines: {node: '>=not-a-version'}

  prod-child@1.5.0:
    resolution: {integrity: sha512-prod-child}
    engines: {node: '>=24'}

  dev-child@1.5.0:
    resolution: {integrity: sha512-dev-child}
    engines: {node: '>=24'}

snapshots:

  ready-prod@1.0.0: {}

  blocked-prod@2.0.0:
    dependencies:
      prod-child: 1.5.0

  dev-only@1.0.0:
    dependencies:
      dev-child: 1.5.0

  invalid-range@1.0.0: {}

  prod-child@1.5.0: {}

  dev-child@1.5.0: {}
