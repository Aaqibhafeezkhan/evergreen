{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/migration-review-log.v1.schema.json",
  "title": "Evergreen migration review log v1",
  "description": "The decision, reviewer, and reasons for every mined migration-commit candidate. See benchmarks/mining/queries.md.",
  "type": "object",
  "required": ["schemaVersion", "method", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "evergreen.migration-review-log.v1" },
    "method": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate", "repository", "parentCommit", "migrationCommit", "ruleId", "decision", "reviewer", "reviewedAt", "license", "checks", "reasons"],
        "additionalProperties": false,
        "properties": {
          "candidate": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "parentCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "migrationCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "ruleId": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["accepted", "rejected"] },
          "reviewer": { "type": "string", "minLength": 1 },
          "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "license": { "type": ["string", "null"] },
          "checks": {
            "type": "object",
            "required": ["parentReportsRule", "migrationClearsRule", "singleParent", "directMigration", "intentStated", "licensed", "publicAndActive"],
            "additionalProperties": false,
            "properties": {
              "parentReportsRule": { "type": "boolean" },
              "migrationClearsRule": { "type": "boolean" },
              "singleParent": { "type": "boolean" },
              "directMigration": { "type": "boolean" },
              "intentStated": { "type": "boolean" },
              "licensed": { "type": "boolean" },
              "publicAndActive": { "type": "boolean" }
            }
          },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
