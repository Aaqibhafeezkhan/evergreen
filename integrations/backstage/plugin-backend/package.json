    "backstage-plugin",
    "evergreen",
    "end-of-life",
    "lifecycle",
    "deprecation"
  ],
  "homepage": "https://github.com/arminazimi/evergreen/tree/main/integrations/backstage#readme",
  "bugs": {
    "url": "https://github.com/arminazimi/evergreen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arminazimi/evergreen.git",
    "directory": "integrations/backstage/plugin-backend"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "backstage": {
