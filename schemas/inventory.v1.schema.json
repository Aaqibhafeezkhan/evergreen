{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/inventory.v1.schema.json",
  "title": "Evergreen inventory v1",
  "description": "The lifecycle verdicts for the resources an export file names, each with the JSON Pointer to the value the claim rests on.",
  "type": "object",
  "required": ["schemaVersion", "results", "unrecognized"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "evergreen.inventory.v1" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "check"],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "object",
            "required": ["importer", "file", "pointer", "resource", "purl"],
            "additionalProperties": false,
            "properties": {
              "importer": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "pointer": {
                "type": "string",
                "pattern": "^(?:/|line:[1-9][0-9]*$)",
                "description": "RFC 6901 JSON Pointer to the version value; for a text export, line:<n>."
              },
              "resource": {
                "type": "string",
                "minLength": 1,
                "description": "The resource's own name. Never an account id, ARN, or secret."
              },
              "purl": { "type": "string", "pattern": "^pkg:" },
              "version": { "type": "string", "minLength": 1 }
            }
          },
          "check": { "$ref": "check.v1.schema.json" }
        }
      }
    },
    "unrecognized": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Files no importer recognized, as given."
    }
  }
}
