  "rule": {
    "ecosystem": "nodejs",
    "event": "removed",
    "id": "nodejs.symbol.fs.rmdir-recursive",
    "migration": {
      "constraints": [
        "Keep the behavior of the call unchanged; check the replacement's argument and error handling differences."
      ],
      "steps": [
        {
          "id": "replace-symbol",
          "instructions": "Replace fs.rmdir(path, { recursive: true }) with fs.rm(path, { recursive: true, force: true }), and the sync form with fs.rmSync.",
          "targets": "usages",
          "title": "Use fs.rm"
        }
      ],
      "verification": [
        {
          "command": "npm run test --if-present",
          "purpose": "Run the repository tests when defined."
        }
      ]
    },
    "provenance": {
      "observedAt": "2026-10-21",
      "reviewedAt": "2026-10-21",
      "reviewer": "arminazimi"
    },
    "purl": "pkg:generic/nodejs",
    "replacement": "fs.rm(path, { recursive: true, force: true })",
    "severity": "high",
    "sources": [
      {
        "title": "Node.js deprecations: DEP0147 fs.rmdir recursive",
        "url": "https://nodejs.org/api/deprecations.html"
      }
    ],
    "summary": "Node.js removed the recursive option of fs.rmdir() and fs.rmdirSync() (DEP0147: documentation-only since v14.14.0, runtime since v16.0.0, end-of-life since v25.0.0).",
    "title": "The recursive option of fs.rmdir has been removed",
    "usage": [
      {
