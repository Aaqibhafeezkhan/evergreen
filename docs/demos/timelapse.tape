# Records the time-lapse section of docs/SHOWCASE.md.
# Generate with: vhs docs/demos/timelapse.tape
Output docs/demos/timelapse.gif

Set Shell "bash"
Set FontSize 14
Set Width 900
Set Height 400
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set Prompt "❯ "

Type "evergreen timelapse . --from 2026-11 --to 2028-10 --no-animation"
Enter
Sleep 4s
