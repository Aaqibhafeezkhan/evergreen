      "migration": {
        "constraints": [
          "Preserve placement, modifiers, boundary and overflow behavior, event listeners, and browser support."
        ],
        "steps": [
          {
            "id": "replace-popper-v1",
            "instructions": "Replace popper.js with @popperjs/core and migrate constructors, options, and modifiers to the Popper v2 API.",
            "targets": "all",
            "title": "Replace Popper v1"
          },
          {
            "id": "verify-positioning",
            "instructions": "Exercise every placement, scrolling container, viewport edge, and dynamic update path used by the interface.",
            "targets": "usages",
            "title": "Verify positioned elements"
          }
        ],
        "verification": [
          {
            "command": "npm run test --if-present",
            "purpose": "Run positioning and repository tests when defined."
          }
        ]
