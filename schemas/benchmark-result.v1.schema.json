{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arminazimi/evergreen/schemas/benchmark-result.v1.schema.json",
  "title": "Evergreen agent proof benchmark result v1",
  "description": "One completed run of the guardrail or plan proof arm. The guardrail and plan runners write these files; tools/benchmark-report.ts reads a directory of them and prints Markdown tables. Offline only; no network.",
  "oneOf": [
    { "$ref": "#/$defs/guardrailResult" },
    { "$ref": "#/$defs/planResult" }
  ],
  "$defs": {
    "namedVersion": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "guardrailOutcomeCounts": {
      "type": "object",
      "required": ["refused", "named-replacement", "other-replacement", "added-deprecated"],
      "additionalProperties": false,
      "properties": {
        "refused": { "type": "integer", "minimum": 0 },
        "named-replacement": { "type": "integer", "minimum": 0 },
        "other-replacement": { "type": "integer", "minimum": 0 },
        "added-deprecated": { "type": "integer", "minimum": 0 }
      }
    },
    "guardrailArmScore": {
      "type": "object",
      "required": ["arm", "attempts", "counts", "rates"],
      "additionalProperties": false,
      "properties": {
        "arm": { "enum": ["baseline", "guardrail"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "counts": { "$ref": "#/$defs/guardrailOutcomeCounts" },
        "rates": {
          "type": "object",
          "description": "Fraction of attempts per outcome, typically rounded to four decimal places by score.ts.",
          "required": ["refused", "named-replacement", "other-replacement", "added-deprecated"],
          "additionalProperties": false,
          "properties": {
            "refused": { "type": "number", "minimum": 0, "maximum": 1 },
            "named-replacement": { "type": "number", "minimum": 0, "maximum": 1 },
            "other-replacement": { "type": "number", "minimum": 0, "maximum": 1 },
            "added-deprecated": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "planArmScore": {
      "type": "object",
      "required": ["arm", "durationMs", "findings", "resolved", "resolutionRate"],
      "additionalProperties": false,
      "properties": {
        "arm": { "enum": ["sequential", "wave-parallel"] },
        "durationMs": { "type": "number", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "resolved": { "type": "integer", "minimum": 0 },
        "resolutionRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "resolved / findings, or 0 when findings is 0; typically four decimal places."
        }
      }
    },
    "guardrailResult": {
      "type": "object",
      "required": ["schemaVersion", "kind", "id", "agent", "model", "startedAt", "finishedAt", "arms"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "evergreen.benchmark-result.v1" },
        "kind": { "const": "guardrail" },
        "id": { "type": "string", "minLength": 1, "description": "Stable id for this run; used only for deterministic row ordering." },
        "agent": { "$ref": "#/$defs/namedVersion" },
        "model": { "$ref": "#/$defs/namedVersion" },
        "startedAt": { "type": "string", "minLength": 1, "description": "ISO-8601 timestamp when the run started." },
        "finishedAt": { "type": "string", "minLength": 1, "description": "ISO-8601 timestamp when the run finished." },
        "arms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/guardrailArmScore" }
        }
      }
    },
    "planResult": {
      "type": "object",
      "required": ["schemaVersion", "kind", "id", "agent", "model", "startedAt", "finishedAt", "arms"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "evergreen.benchmark-result.v1" },
        "kind": { "const": "plan" },
        "id": { "type": "string", "minLength": 1, "description": "Stable id for this run; used only for deterministic row ordering." },
        "agent": { "$ref": "#/$defs/namedVersion" },
        "model": { "$ref": "#/$defs/namedVersion" },
        "startedAt": { "type": "string", "minLength": 1, "description": "ISO-8601 timestamp when the run started." },
        "finishedAt": { "type": "string", "minLength": 1, "description": "ISO-8601 timestamp when the run finished." },
        "arms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/planArmScore" }
        }
      }
    }
  }
}
