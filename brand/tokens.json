{
  "meta": {
    "name": "Evergreen brand tokens",
    "version": "1.0.0",
    "baseSpacingPx": 4,
    "mode": "dark-first"
  },
  "color": {
    "carbon": "#0C1110",
    "deepMineral": "#17211E",
    "forestSlate": "#23423A",
    "mineralGreen": "#4C7C6D",
    "mistGreen": "#9AC7B6",
    "frost": "#F3F6F4",
    "verifiedGreen": "#2F7D5B"
  },
  "semanticColor": {
    "dark": {
      "canvas": "{color.carbon}",
      "surface": "{color.deepMineral}",
      "text": "{color.frost}",
      "textAccent": "{color.mistGreen}",
      "brandPrimary": "{color.forestSlate}",
      "brandSecondary": "{color.mineralGreen}",
      "success": "{color.verifiedGreen}"
    },
    "light": {
      "canvas": "{color.frost}",
      "surface": "#FFFFFF",
      "text": "{color.carbon}",
      "textAccent": "{color.mineralGreen}",
      "brandPrimary": "{color.forestSlate}",
      "brandSecondary": "{color.mistGreen}",
      "success": "{color.verifiedGreen}"
    }
  },
  "font": {
    "sans": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "mono": "IBM Plex Mono, SFMono-Regular, Consolas, Liberation Mono, monospace",
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48,
    "16": 64,
    "24": 96,
    "32": 128
  },
  "radius": {
    "compact": 8,
    "card": 16,
    "panel": 24,
    "round": 999
  },
  "logo": {
    "sourceCanvas": 256,
    "clearSpaceRatio": 0.125,
    "minimumDigitalPx": {
      "fullColor": 32,
      "monochrome": 24,
      "wordmark": 120
    },
    "minimumPrintMm": {
      "fullColor": 8,
      "monochrome": 6,
      "wordmark": 30
    }
  }
}

