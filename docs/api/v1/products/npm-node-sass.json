      "migration": {
        "constraints": [
          "Preserve Sass include paths, importer behavior, output style, source maps, and generated CSS expected by the build."
        ],
        "steps": [
          {
            "id": "replace-sass-dependency",
            "instructions": "Remove node-sass and add the maintained sass package in the same dependency section.",
            "targets": "declaration",
            "title": "Replace Node Sass"
          },
          {
            "id": "update-sass-calls",
            "instructions": "Migrate render and renderSync imports and options to the supported Sass interface used by the project.",
            "targets": "usages",
            "title": "Update compiler usages"
          },
          {
            "id": "compare-css-output",
            "instructions": "Review generated CSS and source maps for behaviorally relevant differences.",
            "targets": "all",
            "title": "Compare compiled output"
          }
        ],
        "verification": [
          {
            "command": "npm run test --if-present",
            "purpose": "Run stylesheet and repository tests when defined."
          },
          {
            "command": "npm run build --if-present",
            "purpose": "Compile the project and its stylesheets with Sass."
          }
        ]
      },
