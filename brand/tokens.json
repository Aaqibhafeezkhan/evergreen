{
  "meta": {
    "name": "Evergreen brand tokens",
    "version": "1.0.0",
    "baseSpacingPx": 4,
    "mode": "dark-first"
  },
  "color": {
    "obsidian": "#0A0A0C",
    "blackCherry": "#2B0B15",
    "deepBurgundy": "#571729",
    "garnet": "#8F3048",
    "dustyRose": "#B96779",
    "warmIvory": "#F3ECE8",
    "mutedPine": "#365C4C"
  },
  "semanticColor": {
    "dark": {
      "canvas": "{color.obsidian}",
      "surface": "{color.blackCherry}",
      "text": "{color.warmIvory}",
      "textAccent": "{color.dustyRose}",
      "brandPrimary": "{color.deepBurgundy}",
      "brandSecondary": "{color.garnet}",
      "success": "{color.mutedPine}"
    },
    "light": {
      "canvas": "{color.warmIvory}",
      "surface": "#FFFFFF",
      "text": "{color.obsidian}",
      "textAccent": "{color.garnet}",
      "brandPrimary": "{color.deepBurgundy}",
      "brandSecondary": "{color.dustyRose}",
      "success": "{color.mutedPine}"
    }
  },
  "font": {
    "sans": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "mono": "IBM Plex Mono, SFMono-Regular, Consolas, Liberation Mono, monospace",
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48,
    "16": 64,
    "24": 96,
    "32": 128
  },
  "radius": {
    "compact": 8,
    "card": 16,
    "panel": 24,
    "round": 999
  },
  "logo": {
    "sourceCanvas": 256,
    "clearSpaceRatio": 0.125,
    "minimumDigitalPx": {
      "fullColor": 32,
      "monochrome": 24,
      "wordmark": 120
    },
    "minimumPrintMm": {
      "fullColor": 8,
      "monochrome": 6,
      "wordmark": 30
    }
  }
}

